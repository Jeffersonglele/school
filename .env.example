# Copiez ce fichier en .env pour le test local (docker compose le lit automatiquement).
# Ne commitez JAMAIS le vrai .env (il est dans .gitignore / .dockerignore).

# --- Base de données (obligatoires) ---
DB_HOST=db
DB_PORT=3306
DB_DATABASE=projet1
DB_USERNAME=school
DB_PASSWORD=changez-moi
# Utilisé seulement par docker-compose pour le conteneur MariaDB local
DB_ROOT_PASSWORD=changez-moi-aussi

# Facultatif : chemin d'un certificat CA si la base externe impose TLS
# (ex. /etc/ssl/certs/ca-certificates.crt)
# DB_SSL_CA=

# --- Comportement au démarrage ---
# DB_WAIT_SECONDS=60       attente max de la base avant d'abandonner
# DB_REQUIRED=true         false = démarrer même si la base est injoignable (pages 503)
# DB_AUTO_MIGRATE=true     false = ne jamais importer le schéma automatiquement

# --- FedaPay ---
FEDAPAY_API_KEY=
FEDAPAY_ENVIRONMENT=sandbox

# --- Application ---
# URL publique, utilisée pour les callbacks de paiement (ex. https://school.onrender.com)
# APP_URL=
# 1 = afficher les erreurs PHP à l'écran (développement uniquement)
# APP_DEBUG=0
# Port local exposé par docker compose
# APP_PORT=8080
